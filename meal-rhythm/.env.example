HOST=127.0.0.1
PORT=3000
ALLOW_GUEST=true
# Generate a random secret with at least 32 characters. Never commit a real secret.
AUTH_SECRET=
DATA_DIR=.data/accounts
# Optional PostgreSQL/Redis deployment; local mode uses serialized files and in-process jobs.
DATABASE_URL=
REDIS_URL=
APPLE_CLIENT_ID=
# Chat-completions compatible HTTPS endpoint, e.g. your provider's /v1/chat/completions
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
